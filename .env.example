# ============================================================
# Talent Trek — environment template
# Copy to .env.local (never commit .env.local) and fill in.
# ============================================================

# --- Site identity ---
# Canonical URL used for metadata, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://talenttrek.com.au
# WordPress origin for headless blog content (optional — blog fails soft).
NEXT_PUBLIC_WP_URL=https://talenttrek.com.au

# --- Analytics ---
# GA4 measurement ID. Injected by the cookie banner only AFTER consent.
NEXT_PUBLIC_GA4_ID=

# --- Contact form / leads (app/api/contact) ---
# If RESEND_API_KEY is set, leads are emailed via Resend (https://resend.com).
# If it is NOT set, leads are still captured to data/leads.jsonl on the server.
RESEND_API_KEY=
# Where lead emails go / which address they come from.
CONTACT_TO_EMAIL=info@talenttrek.com.au
CONTACT_FROM_EMAIL=Talent Trek Website <noreply@talenttrek.com.au>

# --- Legacy WordPress contact form (no longer used by the form) ---
# NEXT_PUBLIC_CF7_FORM_ID=